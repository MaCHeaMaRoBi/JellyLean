<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets"
        id="http://localhost/JellyfinLean" version="1.0.10" viewmodes="fullscreen">

    <access origin="*" subdomains="true"/>

    <tizen:application id="jflean0001.JellyfinLean" package="jflean0001" required_version="2.3"/>

    <author href="https://github.com/MaCHeaMaRoBi/JellyLean">JellyLean</author>
    <name>JellyLean</name>
    <description>Lightweight Jellyfin client for Samsung Tizen TVs (3.0+)</description>
    <icon src="icon.png"/>
    <content src="index.html"/>


    <feature name="http://tizen.org/feature/screen.size.all"/>

    <tizen:profile name="tv"/>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
